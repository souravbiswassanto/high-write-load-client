# Example environment configuration for TLS-enabled PostgreSQL

# Database Configuration
DB_HOST=pg-ha-cluster.demo.svc
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD='CIX6TzfTYFn8~pj4'
DB_NAME=postgres

# SSL/TLS Configuration - Full Certificate Authentication
SSL=ON
DB_SSL_MODE=verify-ca
CLIENT_AUTH_MODE=cert
SSL_ROOT_CERT=/tls/certs/ca.crt
SSL_CERT=/tls/certs/tls.crt
SSL_KEY=/tls/certs/tls.key

# Connection Pool Settings
DB_MAX_OPEN_CONNS=60
DB_MAX_IDLE_CONNS=10
DB_MIN_FREE_CONNS=5

# Load Test Configuration
CONCURRENT_WRITERS=50
TEST_RUN_DURATION=1000
BATCH_SIZE=100
REPORT_INTERVAL=10

# Workload Configuration
INSERT_PERCENT=65
UPDATE_PERCENT=20
TABLE_NAME=load_test_data
READ_PERCENT=15
READ_BATCH_SIZE=10
