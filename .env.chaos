# Example environment configuration for local testing

# Database Configuration
DB_HOST=pg-ha-cluster.demo.svc.cluster.local
DB_PORT=5432
# DB_HOST=127.0.0.1
# DB_PORT=5678
DB_USER=postgres
DB_PASSWORD='CIX6TzfTYFn8~pj4'
DB_NAME=postgres

# SSL/TLS Configuration
SSL=OFF # ON or OFF
DB_SSL_MODE=disable # disable, require, verify-ca, verify-full
CLIENT_AUTH_MODE= # cert, scram, md5, or empty for password-only
SSL_ROOT_CERT=clients/postgres/certificates/ca.crt
SSL_CERT=clients/postgres/certificates/tls.crt
SSL_KEY=clients/postgres/certificates/tls.key

# Connection Pool Settings
DB_MAX_OPEN_CONNS=60
DB_MAX_IDLE_CONNS=10
DB_MIN_FREE_CONNS=5

# Load Test Configuration
CONCURRENT_WRITERS=
TEST_RUN_DURATION=20
BATCH_SIZE=100
REPORT_INTERVAL=20

# Workload Configuration
INSERT_PERCENT=65
UPDATE_PERCENT=20
TABLE_NAME=load_test_data
READ_PERCENT=15
READ_BATCH_SIZE=100
SEED_DATA_ROWS=50000
